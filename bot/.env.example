# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# HTTPS URL of the deployed webapp/ build (Telegram requires HTTPS)
WEBAPP_URL=https://your-domain.example/

# Shared secret the backend sends in the X-Notify-Secret header
NOTIFY_SECRET=change-me
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=8081

# KiGo backend (CRM sign-in and /start registration)
BACKEND_URL=http://127.0.0.1:8010
