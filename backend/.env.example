# Same token as the bot: used to verify Telegram.WebApp.initData
BOT_TOKEN=123456:ABC-your-token

# PostgreSQL (docker compose up -d starts it on 127.0.0.1:5434)
KIGO_DB_PASSWORD=change-me
KIGO_DATABASE_URL=postgresql+psycopg://kigo:change-me@127.0.0.1:5434/kigo

# The bot's notify API (see bot/README.md). Empty = notifications are only logged.
BOT_NOTIFY_URL=http://127.0.0.1:8081/notify
NOTIFY_SECRET=change-me

# Bot username for the CRM sign-in link (t.me/<BOT_USERNAME>?start=login_...)
BOT_USERNAME=charhpalak_bot

# Telegram user ids that are always CRM Super admins, comma separated
ADMIN_IDS=

# Origins allowed to call the API (the deployed webapp). * for development.
CORS_ORIGINS=*

# DEV_MODE=1: requests without initData act as a demo user. Never enable in production.
DEV_MODE=1
DEV_USER_ID=1000

# 1 = fill an empty database with the design's demo data
SEED_DEMO=1

# Tournament page views: salt for the visitor hash (any random string) and whether to trust X-Forwarded-For
# (1 behind a proxy/tunnel, 0 if the API is reachable directly)
VIEW_SALT=
TRUST_PROXY=1
